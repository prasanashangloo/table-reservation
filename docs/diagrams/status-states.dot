digraph G { rankdir=LR; graph [fontname="Helvetica", bgcolor="white", pad=0.3]; node [fontname="Helvetica", fontsize=12, style="filled,rounded", shape=box, fillcolor="#E3F4F3", color="#0E8F8A"]; edge [fontname="Helvetica", fontsize=10, color="#5B6675"];
 s [shape=circle, label="", width=0.2, fillcolor="#1F2A44"]; p [label="PENDING"]; c [label="CONFIRMED"]; x [label="CANCELLED", fillcolor="#F6D5D5", color="#B03030"];
 s->p [label="book"]; p->c [label="confirm"]; p->x [label="cancel"]; c->x [label="cancel"]; }
